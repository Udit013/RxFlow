{
  "name": "@rxflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "cd ../../packages/db && pnpm exec prisma generate",
    "start": "tsx src/server.ts",
    "start:local": "tsx --env-file=.env src/server.ts",
    "deploy:migrate": "cd ../../packages/db && prisma migrate deploy",
    "deploy:seed": "cd ../../packages/db && tsx prisma/seed.ts",
    "type-check": "tsc --noEmit",
    "db:generate": "cd ../../packages/db && prisma generate",
    "db:migrate": "cd ../../packages/db && prisma migrate dev",
    "db:seed": "cd ../../packages/db && ts-node --esm prisma/seed.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@rxflow/db": "workspace:*",
    "@rxflow/medicine-intelligence": "workspace:*",
    "@rxflow/regional": "workspace:*",
    "@rxflow/types": "workspace:*",
    "bcryptjs": "^2.4.3",
    "dayjs": "^1.11.23",
    "fastify": "^5.12.7",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "resend": "^6.34.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "typescript": "^6.0.3"
  }
}
