{
  "name": "rxflow",
  "version": "0.1.0",
  "private": true,
  "description": "RxFlow — Connected Pharma Distribution Network",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint apps packages",
    "type-check": "turbo run type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "db:studio": "cd packages/db && npx prisma studio",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0 <27.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.1.0",
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.9",
      "follow-redirects": "^1.16.1",
      "nanoid@3": "^3.3.18",
      "source-map-js": "^1.2.2",
      "fflate": "^0.8.3",
      "fast-copy": "^3.1.0",
      "postcss": "^8.5.23",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "postcss-selector-parser@6": "^6.1.3",
      "js-yaml@4": "^4.3.2",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "vite": "^8.3.5"
    }
  }
}
